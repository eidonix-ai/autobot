# Autobot, and this machine's token: shown once when an admin adds the machine in Autobot.
AUTOBOT_URL=https://autobot.eidonix.com
CONNECTOR_TOKEN=

# The image test runs use, by name or id. It must already be on this machine.
WORK_IMAGE=flare-donor-work:local

# A folder of models. Runs see it read-only at /models, and Autobot lists what is in it.
MODELS_DIR=/home/you/.cache/huggingface/hub

# What one run gets. Defaults: half the CPUs, half the memory, 16 GiB of scratch space (which is
# part of its memory).
#JOB_CPUS=
#JOB_MEMORY_GIB=
#JOB_SCRATCH_GIB=16

# Take no new run while a GPU is this hot (°C), and stop a run that reaches it.
#MAX_GPU_TEMP=83

# A host folder for downloaded code.
#DATA_DIR=/var/lib/autobot-connector
